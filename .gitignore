```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Coverage
coverage/
htmlcov/
.coverage

# Python cache (if present)
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/
```