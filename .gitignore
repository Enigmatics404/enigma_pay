*.log

# Environment variables
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
jspm_packages/
web_modules/
*.tsbuildinfo
.next/
.nuxt/
dist/

# TypeScript
*.tsbuildinfo
.next/
.nuxt/
dist/

# Coverage directory used by tools like istanbul
coverage/
lib-cov/

# Temporary folders
tmp/
temp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
